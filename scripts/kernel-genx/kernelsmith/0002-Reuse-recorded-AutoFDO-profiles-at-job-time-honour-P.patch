 crates/core/src/autofdo.rs |  6 +++++-
 crates/core/src/job.rs     |  3 +++
 crates/core/src/plan.rs    | 13 ++++++++++++-
 crates/core/src/script.rs  | 25 ++++++++++++++++++++-----
 5 files changed, 43 insertions(+), 8 deletions(-)

