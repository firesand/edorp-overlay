# GenX: ASUS ROG MAXIMUS Z790 HERO, i9-14900K (8P+16E, 32 threads, one NUMA
# node, no LA57), RTX 4090 (nvidia kernel-open), NVMe behind Intel VMD,
# I226-V, AX211 CNVi Wi-Fi/BT, USB4/Thunderbolt. iGPU disabled in firmware.
# Everything here is a built-in (=y) decision; module trimming is done by
# "make localmodconfig" in genconfig.sh, not by this file.

## CPU: exactly this socket (32 threads -> no off-stack cpumasks)
# (vendor selection would need CONFIG_EXPERT; the AMD/Hygon code paths cost
#  nothing at runtime, so they are left alone)
# CONFIG_MAXSMP is not set
CONFIG_NR_CPUS=32
# CONFIG_X86_5LEVEL is not set
# CONFIG_X86_SGX is not set
# CONFIG_INTEL_TDX_HOST is not set
# CONFIG_AMD_MEM_ENCRYPT is not set
# CONFIG_AMD_IOMMU is not set
CONFIG_X86_NATIVE_CPU=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_CLUSTER=y
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_IDLE=y

## Single-node desktop memory topology. MEMORY_HOTPLUG stays on: ZONE_DEVICE,
## DEVICE_PRIVATE and HMM_MIRROR (nvidia-uvm / CUDA HMM) depend on it.
# CONFIG_NUMA is not set
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_HMM_MIRROR=y
# CONFIG_ACPI_HOTPLUG_MEMORY is not set

## Bare metal only: no guest/paravirt support (KVM *host* stays enabled)
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_EFI_MIXED is not set
# CONFIG_X86_X32_ABI is not set

## LSMs that are compiled in but never in CONFIG_LSM
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_IPE is not set
# CONFIG_SECURITY_LOADPIN is not set
# CONFIG_SECURITY_SAFESETID is not set
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_DEFAULT_SECURITY_DAC=y

## Debug knobs with runtime cost and no use on this box
# CONFIG_ACPI_DEBUG is not set
# CONFIG_IKHEADERS is not set

## Root path built in: boots even with a broken initramfs
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VMD=y
CONFIG_BTRFS_FS=y
CONFIG_SATA_AHCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y

## GPUs that are not in this machine. nouveau STAYS as a module: nvidia_drm
## links against drm_ttm_helper and drm_display_helper, promptless symbols
## that only exist while an in-tree driver selects them, and nouveau is the
## in-tree driver for this very GPU (blacklisted by nvidia-drivers' modprobe.d).
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_XE is not set
CONFIG_DRM_NOUVEAU=m
# nouveau's SVM is what selects HMM_MIRROR once i915/xe/amdgpu are gone
CONFIG_DRM_NOUVEAU_SVM=y
CONFIG_DRM_TTM=m
CONFIG_DRM_TTM_HELPER=m
CONFIG_DRM_DISPLAY_HELPER=m
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_AGP is not set
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_EFI=y

## Kept only so the dist-kernel QEMU boot test (USE=test) finds its IDE disk
CONFIG_ATA_PIIX=m
