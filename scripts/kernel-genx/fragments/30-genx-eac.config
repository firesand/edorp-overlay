# GenX: Easy Anti-Cheat Linux v2 kernel requirements.
# Reference: CachyOS linux-cachyos-eac PKGBUILD (branch "eac") and
# https://onlineservices.epicgames.com/news/introducing-easy-anti-cheat-linux-v2
#
# Two deliberate differences from the CachyOS EAC kernel, because this is the
# ONE kernel for daily use as well:
#   * lockdown is not forced in Kconfig. The EAC boot entry passes
#     lockdown=integrity (Epic checks the measured command line anyway), and
#     the normal entry stays unlocked so intel-undervolt / MSR tools keep
#     working.
#   * INTEL_IOMMU_DEFAULT_ON stays off; the EAC entry passes
#     intel_iommu=on iommu.passthrough=0.
# Everything else matches: signed modules only, no MOK trust, BPF LSM,
# TPM 2.0 drivers built in, lockdown LSM armed early.

CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY is not set
# CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY is not set
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_LSM=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_INTEGRITY=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

## Signed modules only, trusting nothing but the key built into the kernel
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_SECONDARY_TRUSTED_KEYRING=y
CONFIG_SECONDARY_TRUSTED_KEYRING_SIGNED_BY_BUILTIN=y
# CONFIG_INTEGRITY_MACHINE_KEYRING is not set
# CONFIG_MODULE_FORCE_LOAD is not set

## IOMMU with DMA translation available (turned on from the EAC entry)
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_SVM=y
CONFIG_INTEL_IOMMU_SCALABLE_MODE_DEFAULT_ON=y
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
# CONFIG_IOMMU_DEFAULT_PASSTHROUGH is not set
CONFIG_IRQ_REMAP=y

## TPM 2.0 (Intel PTT on this board is CRB)
CONFIG_TCG_TPM=y
CONFIG_TCG_TPM2_HMAC=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y

## Secure Boot ready image
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y

## kexec stays compiled (as in CachyOS) and is disabled at boot via
## sysctl.kernel.kexec_load_disabled=1 on the EAC entry.
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_SIG=y
