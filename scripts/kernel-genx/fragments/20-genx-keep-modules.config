# GenX: modules that were not loaded when lsmod-GenX.txt was taken but are
# wanted on a gaming/dev desktop. Whole subsystems that must survive hotplug
# (USB, HID, input, Bluetooth, USB audio/video, hwmon, dm/md, block, fs,
# netfilter, net/sched, crypto, lib) are kept via LMC_KEEP in genconfig.sh.

## Optical / generic SCSI (external USB drives)
CONFIG_BLK_DEV_SR=m
CONFIG_CDROM=m
CONFIG_CHR_DEV_SG=m

## Virtual networking for Docker/Tailscale/VMs
## (WIREGUARD and BRIDGE_NETFILTER live in drivers/net/Kconfig and net/Kconfig,
##  which LMC_KEEP's per-Kconfig-file matching does not cover)
CONFIG_WIREGUARD=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_DUMMY=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_IPVLAN=m
CONFIG_IPVTAP=m
CONFIG_VXLAN=m
CONFIG_TAP=m
CONFIG_IFB=m
CONFIG_VLAN_8021Q=m
CONFIG_TLS=m
CONFIG_VSOCKETS=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m

## Sound: loopback / virtual MIDI for streaming setups
CONFIG_SND_ALOOP=m
CONFIG_SND_VIRMIDI=m

## Platform
CONFIG_EDAC_IE31200=m
CONFIG_INPUT_UINPUT=m
