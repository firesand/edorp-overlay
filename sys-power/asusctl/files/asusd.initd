#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

description="ASUS ROG/TUF laptop control daemon (asusd)"

supervisor="supervise-daemon"
command="/usr/bin/asusd"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="${output_log:-/var/log/asusd.log}"
error_log="${error_log:-${output_log}}"

# Same limits as upstream's asusd.service: Restart=on-failure, RestartSec=1,
# StartLimitBurst=5 within StartLimitInterval=500.
respawn_delay=1
respawn_max=5
respawn_period=500

depend() {
	need dbus
	use logger elogind
	after udev modules-load
	before asus-shutdown
}

start_pre() {
	# On systemd udev starts asusd only on supported ASUS machines
	# (SYSTEMD_WANTS in 99-asusd.rules). OpenRC has no such hook, so refuse
	# to run elsewhere instead of looping on a failing daemon.
	local vendor
	vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)
	case ${vendor} in
		ASUS*) ;;
		*)
			eerror "${RC_SVCNAME}: this is not an ASUS machine (DMI vendor: ${vendor:-unknown})"
			return 1
			;;
	esac

	checkpath -f -m 0640 -o root:root "${output_log}" || return 1

	# Upstream: IS_SERVICE=1 selects daemon mode, the sleep avoids init
	# problems with hid_asus and the keyboard MCU.
	export IS_SERVICE=1
	export RUST_LOG="${RUST_LOG:-info,tracing::span=error,zbus::object_server=error,zbus::connection::handshake::common=error,zbus::connection::handshake::client=error}"
	sleep 1
}
